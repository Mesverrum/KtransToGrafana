services:
  # Split-horizon DNS for ktranslate flow/sFlow reverse lookups (src_host / dst_host).
  # Local PTR from SNMP device catalog; upstream recursion to host DNS.
  flow_dns:
    image: ${FLOW_DNS_IMAGE:-andyshinn/dnsmasq:2.83}
    container_name: flow_dns
    restart: always
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - type: bind
        source: ./dnsmasq/dnsmasq.conf
        target: /etc/dnsmasq.conf
        read_only: true
      - type: bind
        source: ./dnsmasq/hosts.generated.conf
        target: /etc/dnsmasq.d/hosts.generated.conf
        read_only: true
      - type: bind
        source: ./dnsmasq/upstream.conf
        target: /etc/dnsmasq.d/upstream.conf
        read_only: true
      - type: bind
        source: ./dnsmasq/extra-hosts.conf
        target: /etc/dnsmasq.d/extra-hosts.conf
        read_only: true

  ktranslate_flow:
    image: ${KTRANSLATE_IMAGE:-quay.io/kentik/ktranslate:latest}
    restart: always
    pull_policy: always
    environment:
      # ${KTRANS_HOST:+-}${KTRANS_HOST} appends "-<host>" only when KTRANS_HOST
      # is set, so service.name reads e.g. "ktranslate-flow-site-a" (blank -> no suffix).
      - OTEL_SERVICE_NAME=ktranslate-flow${KTRANS_HOST:+-}${KTRANS_HOST}
      - OTEL_EXPORTER_OTLP_COMPRESSION=${OTEL_EXPORTER_OTLP_COMPRESSION}
    # config/catalog.yaml + state/devices-*.yaml mounts: compose-catalog.generated.yaml
    depends_on:
      - alloy
      - flow_dns
    command:
      - --format=otel
      - --format_metric=otel
      - --otel.protocol=grpc
      - --otel.endpoint=http://alloy:4317/
      - --snmp=/snmp.yaml
      - --flow_only=true
      - --nf.source=${NF_SOURCE}
      - --metalisten=0.0.0.0:9996
      - --dns=${FLOW_DNS:-flow_dns:53}
      - --sinks=otel
      - --metrics=jchf
      - --tee_logs=true
      - --service_name=flow
      - --max_flows_per_message=100
      - --rollup_interval=60
      - --rollup_top_k=100
      - --rollups=s_sum,bytes_by_flow,in_bytes+out_bytes,src_addr,dst_addr,l4_src_port,l4_dst_port,protocol,custom_str.application,device_name,custom_str.src_host,custom_str.dst_host,src_geo,dst_geo
      - --rollup_keep_undefined=true
    ports:
      - 9995:9995/udp
      - 9996:9996

  ktranslate_syslog:
    image: ${KTRANSLATE_IMAGE:-quay.io/kentik/ktranslate:latest}
    restart: always
    pull_policy: always
    environment:
      - OTEL_SERVICE_NAME=ktranslate-syslog${KTRANS_HOST:+-}${KTRANS_HOST}
      - OTEL_EXPORTER_OTLP_COMPRESSION=${OTEL_EXPORTER_OTLP_COMPRESSION}
    # catalog volumes: compose-catalog.generated.yaml
    depends_on:
      - alloy
    command:
      - --format=otel
      - --format_metric=otel
      - --otel.protocol=grpc
      - --otel.endpoint=http://alloy:4317/
      - --snmp=/snmp.yaml
      - --flow_only=true
      - --syslog.source=${SYSLOG_SOURCE}
      - --metalisten=0.0.0.0:9998
      - --sinks=otel
      - --metrics=jchf
      - --tee_logs=true
      - --service_name=syslog
    ports:
      - 1514:1514/udp
      - 1514:1514/tcp
      - 9998:9998

  alloy:
    image: ${ALLOY_IMAGE:-grafana/alloy:latest}
    restart: always
    pull_policy: always
    environment:
      - GC_OTLP_URL=${GC_OTLP_URL}
      - GC_OTLP_ACCOUNT=${GC_OTLP_ACCOUNT}
      - GC_OTLP_KEY=${GC_OTLP_KEY}
      - OTEL_METRIC_EXPORT_INTERVAL=1000
      # Read by Alloy's resourcedetection "env" detector and stamped onto every
      # signal passing through, so all telemetry from this host carries it.
      - OTEL_RESOURCE_ATTRIBUTES=deployment.host=${KTRANS_HOST}
    volumes:
      - type: bind
        source: /opt/Grafana/KtransToGrafana/config.alloy
        target: /config.alloy
    ports:
      - 4317:4317
      - 12346:12346
    command:
      - --server.http.listen-addr=0.0.0.0:12346
      - --storage.path=/var/lib/alloy/data
      - --stability.level=experimental
      - run
      - /config.alloy
