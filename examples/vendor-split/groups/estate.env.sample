# Estate-wide SNMP discovery — scan mixed CIDRs, then split into pollers.
# Copy to groups/estate.env (without .sample). Do NOT also copy onboarding.env:
# make generate / make up start every groups/*.env.
#
# ROLE=discover: no long-running poller for this group. Discovery writes
# state/devices-estate.yaml; make split-devices (or the discover hook) provisions
# ROLE=poll groups from the device list. Optional static mapping:
#   cp examples/vendor-split/device-split.yaml config/device-split.yaml
#   make generate && make up && make discover GROUP=estate

GROUP=estate
ROLE=discover

SNMP_VERSION=mixed
SNMP_V2_COMMUNITY="public,corp-ro,net-mon"

SNMP_V3_USER=netops
SNMP_V3_AUTH_PROTOCOL=SHA
SNMP_V3_AUTH_PASS=REPLACE_ME_AUTH
SNMP_V3_PRIV_PROTOCOL=AES
SNMP_V3_PRIV_PASS=REPLACE_ME_PRIV

DISCOVERY_SOURCE=cidr
# Comma-separated CIDRs / /32s that mix vendors. Discovery does not care.
TARGETS=10.0.0.0/24,10.10.0.0/24

DISCOVERY_THREADS=8
POLL_INTERVAL_SEC=60
