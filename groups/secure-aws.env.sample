# SNMPv3 via AWS Secrets Manager — optional alternative to inline SNMP_V3_* fields.
#
# Copy to groups/secure-aws.env, set TARGETS + SNMP_V3_SECRET, put AWS_REGION in
# .env (and IAM access for the host or temporary keys), then:
#   make generate && make up && make discover GROUP=secure-aws
#
# Full walkthrough: docs/secrets-aws.md
# Kentik wiki: https://github.com/kentik/ktranslate/wiki/Advanced-Ktranslate-Configuration
#
# GROUP and ports must be unique across groups/ and must not collide with
# compose-base.yaml static ports (9995, 9996, 9998, 4317, 12346, 1514).

GROUP=secure-aws
# Becomes snmp_group on SNMP metrics (poller global.user_tags). Must be unique.

# Cloud secrets require SNMPv3 (Kentik does not resolve aws.sm. for v2c communities).
SNMP_VERSION=v3

# Whole SNMPv3 profile as one Secrets Manager secret (JSON — see docs/secrets-aws.md).
# Do NOT also set SNMP_V3_USER / SNMP_V3_AUTH_PASS / … when using this.
SNMP_V3_SECRET=aws.sm.ktrans-snmp-v3

# Optional extra v3 profiles for discovery to try (same aws.sm. form):
# SNMP_V3_SECRET_2=aws.sm.ktrans-snmp-v3-backup

# Leave inline v3 fields empty when using SNMP_V3_SECRET.
SNMP_V3_USER=
SNMP_V3_AUTH_PROTOCOL=
SNMP_V3_AUTH_PASS=
SNMP_V3_PRIV_PROTOCOL=
SNMP_V3_PRIV_PASS=

SNMP_V2_COMMUNITY=

# Community string applied to incoming SNMP traps for this group (still local).
TRAP_COMMUNITY=public

DISCOVERY_SOURCE=cidr
TARGETS=192.168.1.1/32

METALISTEN_PORT=9987
TRAP_PORT=1630

DISCOVERY_THREADS=2
POLL_INTERVAL_SEC=60
