# Estate-wide SNMP discovery — scan mixed CIDRs, then split by vendor.
# Copy to groups/estate.env (without .sample). Do NOT also copy onboarding.env
# or single.env: make generate / make up start every groups/*.env.
#
# ROLE=discover means there is no long-running poller for this group. Discovery
# writes state/devices-estate.yaml; scripts/split-devices-by-vendor.py then
# copies each device into cisco / palo / juniper / other poller files.
#
# Pair with the ROLE=poll samples in this directory:
#   cp examples/vendor-split/groups/*.env.sample groups/
#   # then strip .sample: estate.env, cisco.env, palo.env, juniper.env, other.env
#   cp examples/vendor-split/vendor-split.yaml config/vendor-split.yaml
#   make generate && make up && make discover GROUP=estate

GROUP=estate
ROLE=discover

SNMP_VERSION=mixed
SNMP_V2_COMMUNITY="public,corp-ro,net-mon"

SNMP_V3_USER=netops
SNMP_V3_AUTH_PROTOCOL=SHA
SNMP_V3_AUTH_PASS=REPLACE_ME_AUTH
SNMP_V3_PRIV_PROTOCOL=AES
SNMP_V3_PRIV_PASS=REPLACE_ME_PRIV

DISCOVERY_SOURCE=cidr
# Comma-separated CIDRs / /32s that mix vendors. Discovery does not care.
TARGETS=10.0.0.0/24,10.10.0.0/24

DISCOVERY_THREADS=8
POLL_INTERVAL_SEC=60
