# Cisco poller — inventory comes from estate discovery + device-split.yaml, not a
# second CIDR scan. Copy to groups/cisco.env. ROLE=poll: no discover_cisco
# container. Credentials on each device were stamped during estate discovery;
# SNMP_V2_COMMUNITY here is only a generator fallback.

GROUP=cisco
ROLE=poll
DISCOVERY_SOURCE=split

SNMP_VERSION=v2c
SNMP_V2_COMMUNITY=public
TRAP_COMMUNITY=public

METALISTEN_PORT=9997
TRAP_PORT=1620
POLL_INTERVAL_SEC=60
DISCOVERY_THREADS=4
