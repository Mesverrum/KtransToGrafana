                      "spec": {
                        "expr": "sum by (device_name, TrapName) (count_over_time({service_name=~\"ktranslate.*\"} | json | eventType=\"KSnmpTrap\" | TrapName =~ \"(?i).*link.*\" [$__interval]))",
