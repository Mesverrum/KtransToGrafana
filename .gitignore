# Local secrets and runtime state — never commit.
.env
config.alloy
compose-base.yaml
compose.override.yaml

# Legacy single-poller runtime files (pre-consolidation). Kept ignored so an
# upgrade from the old single-poller layout doesn't surface stale local copies.
compose.yaml
snmp.yaml

# Generator inputs with real credentials (templates are in groups/*.env.sample).
groups/*.env
!groups/*.env.sample

# Generator outputs (re-created by scripts/generate-groups.sh).
config/*.yaml
compose-groups.generated.yaml
compose-catalog.generated.yaml
compose-limits.generated.yaml

# Discovery runtime artifacts (written by scripts/run-discovery.sh).
state/*.yaml
!state/.gitkeep

# Kubernetes generator outputs (scripts/generate-k8s.py).
k8s/generated/*
!k8s/generated/.gitkeep

# flow_dns generated records (scripts/refresh-flow-dns.sh).
dnsmasq/hosts.generated.conf
dnsmasq/upstream.conf

# Python bytecode from generate-k8s.py
scripts/__pycache__/

# OS and editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
