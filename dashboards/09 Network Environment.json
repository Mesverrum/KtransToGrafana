                      "spec": {
                        "expr": "count by(device_name, entity_name, entity_sensor_type) ({__name__=~\"(?i)kentik_snmp_.*(entSensor|dBm|optical|rxPower|txPower).*\",tags_snmp_group=~\"$snmp_group\",provider=~\"$provider\",device_name=~\"$device_name\"}) OR on() vector(0)",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "labelsToFields",
                  "group": "",
                  "spec": {
                    "disabled": false,
                    "options": null
                  }
                },
                {
                  "kind": "merge",
                  "group": "",
