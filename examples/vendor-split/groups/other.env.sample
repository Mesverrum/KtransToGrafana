# Catch-all poller for devices that did not match a split rule (or whose
# destination has no ROLE=poll group). Keep this group so discovery never
# silently drops a box.

GROUP=other
ROLE=poll
DISCOVERY_SOURCE=split

SNMP_VERSION=v2c
SNMP_V2_COMMUNITY=public
TRAP_COMMUNITY=public

METALISTEN_PORT=9986
TRAP_PORT=1624
POLL_INTERVAL_SEC=60
DISCOVERY_THREADS=4
