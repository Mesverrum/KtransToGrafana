OTEL_SERVICE_NAME=ktranslate
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
NF_SOURCE=auto

# Identifies which ktranslate host this stack runs on. It does two things:
#   1. Alloy stamps it onto every signal (SNMP, flow, syslog, discovery, and
#      ktranslate's own health metrics) as the label `deployment_host`.
#   2. It is appended to each container's service.name, e.g.
#      ktranslate-snmp-cisco-site-a / ktranslate-syslog-site-b, so the two
#      hosts never share a service name in Grafana.
#
# Leave this BLANK to have `make` auto-fill it with the machine's hostname, so
# each host self-identifies with no config. Set an explicit value only if you
# want a friendlier name (e.g. site-a / site-b); an explicit value always wins.
# NOTE: the auto-fallback only applies when starting via `make up`; a raw
# `docker compose up` reads this value verbatim.
KTRANS_HOST=
GC_OTLP_URL=https://foo/otlp
GC_OTLP_ACCOUNT=0000000
GC_OTLP_KEY=glc_foo
SYSLOG_SOURCE=0.0.0.0:1514

# flow_dns — ktranslate reverse DNS for src_host / dst_host on NetFlow rollups.
# Local PTR from state/devices-*.yaml; upstream recursion to host DNS.
FLOW_DNS=flow_dns:53
FLOW_DNS_UPSTREAM=host.docker.internal
# Optional name:ip pairs not in SNMP discovery (comma-separated):
# FLOW_DNS_EXTRA_HOSTS=client1:172.17.0.1,client2:172.17.0.2
# Optional docker network overlay (ContainerLab / dynamic mgmt IPs):
# FLOW_DNS_DOCKER_NETWORK=clab
# FLOW_DNS_DOCKER_NODES=spine1 leaf1 leaf2 client1 client2
FLOW_DNS_IMAGE=

# Container images. Leave blank to track :latest. Prefer pinning in production, e.g.:
#   KTRANSLATE_IMAGE=quay.io/kentik/ktranslate:v2.2.37
#   ALLOY_IMAGE=grafana/alloy:v1.8.3
KTRANSLATE_IMAGE=
ALLOY_IMAGE=

# Per-container memory limits (generated by scripts/compute-limits.sh on make up).
# Set MEM_LIMITS=off to disable. Limits are per-container, not a project-wide cap.
# MEM_BUDGET_FRACTION=0.80
# MEM_SNMP_MAX=4g
# MEM_SNMP_MIN=512m
# MEM_SNMP_LIMIT=
# MEM_FLOW_LIMIT=
# MEM_ALLOY_LIMIT=
# MEM_SYSLOG_LIMIT=

# NetBox — only needed if any group sets DISCOVERY_SOURCE=netbox. These are
# shared by all netbox groups; the per-group NETBOX_* filters live in
# groups/<name>.env. Leave blank for cidr-only deployments.
NETBOX_HOST=
NETBOX_TOKEN=

# Grafana HTTP API — optional; used by scripts/push-dashboards.py to import dashboards/ to your stack.
# Create a service-account token with dashboard write (Editor/Admin).
# GRAFANA_URL=https://yourstack.grafana.net
# GRAFANA_TOKEN=glsa_REPLACE_ME
# GRAFANA_DASHBOARD_FOLDER=network-lab
# GRAFANA_DASHBOARD_NAMESPACE=stacks-0000000
# KTRANS_PUSH_SKIP=02 Network Flow Summary.json

# host-sflow demo overlay only (compose-sflow.yaml): the host interface sflow
# should read. Run `make detect-net` to auto-fill it, or set it manually to what
# `ip route show default` reports. Ignored unless you enable the sflow overlay.
HOST_NET=ens4
