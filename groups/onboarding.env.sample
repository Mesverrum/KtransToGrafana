# Copy to groups/onboarding.env, set TARGETS + credentials, then:
#   make generate && make up && make discover GROUP=onboarding
#
# SNMP_VERSION:
#   v2c    — communities only (SNMP_V2_COMMUNITY="public,corp-ro")
#   v3     — the SNMP_V3_* block (all five fields). Extra users: _2, _3, … _9
#   mixed  — try both (default below). Discovery records whichever worked per device.
#
# One device: TARGETS=192.168.1.1/32
# More (NetBox, vendor pollers): docs/configuration.md
#
# Quote values with spaces or commas. Copy only this file for the first run
# (make up starts every groups/*.env).

GROUP=onboarding
# Becomes snmp_group on SNMP metrics. Leave as onboarding for the quickstart.

# "mixed" = try BOTH the v2c communities and the v3 sets below during discovery.
# (Use "v2c" if you only have communities, or "v3" if you only have v3 creds.)
SNMP_VERSION=mixed

# Candidate v2c communities, comma-separated. Discovery tries each per device.
SNMP_V2_COMMUNITY="public,corp-ro,net-mon"

# Candidate v3 credentials. The primary (unsuffixed) set plus optional numbered
# sets _2, _3, ... (up to _9). Each set must be complete (all five fields).
SNMP_V3_USER=netops
SNMP_V3_AUTH_PROTOCOL=SHA
SNMP_V3_AUTH_PASS=REPLACE_ME_AUTH
SNMP_V3_PRIV_PROTOCOL=AES
SNMP_V3_PRIV_PASS=REPLACE_ME_PRIV

# A second candidate v3 set (delete these if you only have one). Add _3, _4, ...
# the same way for more.
SNMP_V3_USER_2=monitor
SNMP_V3_AUTH_PROTOCOL_2=SHA256
SNMP_V3_AUTH_PASS_2=REPLACE_ME_AUTH2
SNMP_V3_PRIV_PROTOCOL_2=AES256
SNMP_V3_PRIV_PASS_2=REPLACE_ME_PRIV2

# Community string applied to incoming SNMP traps.
TRAP_COMMUNITY=public

DISCOVERY_SOURCE=cidr
TARGETS=10.0.0.0/24
# NETBOX_TAG=
# NETBOX_SITE=
# NETBOX_LOCATION=
# NETBOX_TENANT=
# NETBOX_ROLE=
# NETBOX_STATUS=active
# NETBOX_IP_TO_PICK=primary

# Leave these until you add more groups/*.env files.
METALISTEN_PORT=9989
TRAP_PORT=1622

# Discovery and polling tuning. Many credentials x many IPs = many probes;
# raise threads for speed, but mind device/IDS load and account lockouts.
DISCOVERY_THREADS=8
POLL_INTERVAL_SEC=60
