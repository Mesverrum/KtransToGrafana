OTEL_SERVICE_NAME=ktranslate
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
NF_SOURCE=auto

# Identifies which ktranslate host this stack runs on. It does two things:
#   1. Alloy stamps it onto every signal (SNMP, flow, syslog, and ktranslate's
#      own health metrics) as the label `deployment_host`.
#   2. It is appended to each container's service.name, e.g.
#      ktranslate-snmp-site-a / ktranslate-syslog-site-b, so two hosts never
#      share a service name in Grafana.
#
# Leave this BLANK to have `make` auto-fill it with the machine's hostname, so
# each host self-identifies with no config. Set an explicit value only if you
# want a friendlier name (e.g. site-a / site-b); an explicit value always wins.
# NOTE: the auto-fallback only applies when starting via `make up`; a raw
# `docker compose up` reads this value verbatim.
KTRANS_HOST=
GC_OTLP_URL=https://foo/otlp
GC_OTLP_ACCOUNT=0000000
GC_OTLP_KEY=glc_foo
SYSLOG_SOURCE=0.0.0.0:1514

# Container images. Leave blank to track :latest. Prefer pinning in production, e.g.:
#   KTRANSLATE_IMAGE=quay.io/kentik/ktranslate:v2.2.37
#   ALLOY_IMAGE=grafana/alloy:v1.8.3
KTRANSLATE_IMAGE=
ALLOY_IMAGE=

# Per-container memory limits (generated by scripts/compute-limits.sh on make up).
# Set MEM_LIMITS=off to disable. Limits are per-container, not a project-wide cap.
# MEM_BUDGET_FRACTION=0.80
# MEM_SNMP_MAX=4g
# MEM_SNMP_MIN=512m
# MEM_SNMP_LIMIT=
# MEM_FLOW_LIMIT=
# MEM_ALLOY_LIMIT=
# MEM_SYSLOG_LIMIT=

# Host interface for host-sflow to listen on. See README for an auto-detect
# one-liner, or set this manually to whatever `ip route show default` reports.
HOST_NET=ens4
