      "panel-811": {
        "kind": "Panel",
        "spec": {
          "id": 811,
          "title": "Admin-up interfaces down",
          "description": "Live oper-down count (admin-up only) \u2014 correlate with link flaps.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "count(kentik_snmp_if_OperStatus{tags_snmp_group=~\"$snmp_group\",provider=~\"$provider\",device_name=~\"$device_name\",if_AdminStatus!=\"down\"} != 1) OR vector(0)",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
