    "elements": {
      "panel-801": {
        "kind": "Panel",
        "spec": {
          "id": 801,
          "title": "Traps (range)",
          "description": "Total SNMP trap events in the dashboard time range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "$loki"
                      },
                      "spec": {
                        "expr": "sum(count_over_time({service_name=~\"ktranslate.*\"} | json | eventType=\"KSnmpTrap\" [$__range]))",
                        "instant": false,
                        "legendFormat": "__auto",
                        "queryType": "range",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.0-31575599388",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "reduceOptions": {
                  "calcs": [
                    "sum"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0
                },
                "overrides": []
              }
            }
          }
        }
