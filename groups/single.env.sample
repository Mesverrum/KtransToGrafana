# Minimal single-device shorthand. Prefer groups/onboarding.env with
# TARGETS=<ip>/32 — same path, no extra sample. Copy this only if you already
# use GROUP=single. Do not copy alongside onboarding.env.

GROUP=single
# Becomes snmp_group on SNMP metrics (poller global.user_tags). Must be unique.

# SNMP version this device uses. Either "v2c" or "v3".
SNMP_VERSION=v2c

# v3 credentials (used when SNMP_VERSION=v3, ignored otherwise).
SNMP_V3_USER=
SNMP_V3_AUTH_PROTOCOL=
SNMP_V3_AUTH_PASS=
SNMP_V3_PRIV_PROTOCOL=
SNMP_V3_PRIV_PASS=

# v2c community (used when SNMP_VERSION=v2c, ignored otherwise).
SNMP_V2_COMMUNITY=public

# Community string applied to incoming SNMP traps for this group.
TRAP_COMMUNITY=public

# Device list source: cidr (scan TARGETS) or netbox (query NetBox).
DISCOVERY_SOURCE=cidr

# DISCOVERY_SOURCE=cidr: the one device (or small range) to poll.
TARGETS=192.168.1.1/32

# Host ports for this group. Must be unique across all groups.
METALISTEN_PORT=9997
TRAP_PORT=1620

# Discovery and polling tuning.
DISCOVERY_THREADS=2
POLL_INTERVAL_SEC=60
